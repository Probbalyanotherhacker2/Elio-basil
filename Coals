local function createButton(text, posY, width, posX, callback)
	local btn = Instance.new("TextButton", MainFrame)
	btn.Size = UDim2.new(0, width or 290, 0, 28)
	btn.Position = UDim2.new(0, posX or 15, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(66, 83, 103)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = text
	btn.TextSize = 13
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	btn.MouseButton1Click:Connect(function()
		local targetName = TargetBox.Text
		callback(targetName)
	end)
	return btn
end

