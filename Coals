Instance.new("UICorner", PickDirBtn).CornerRadius = UDim.new(0, 6)

PickDirBtn.MouseButton1Click:Connect(function()
	SelectedSlamTarget = nil
	notify("Slam Direction", "Click anywhere in the world to set launch direction!")
	local mouseConn
	mouseConn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			mouseConn:Disconnect()
			local camera = workspace.CurrentCamera
			local mouse = LocalPlayer:GetMouse()
			local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
			local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
			if result then
				SelectedSlamTarget = result.Position
				notify("Slam Direction", "Direction locked successfully!")
			else
				SelectedSlamTarget = camera.Focus.Position
				notify("Slam Direction", "Direction set to camera focus!")
			end
		end
	end)
end)

