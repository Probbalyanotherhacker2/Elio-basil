GiveToolBtn.MouseButton1Click:Connect(function()
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local character = LocalPlayer.Character
	if not backpack or not character then return end
	
	if backpack:FindFirstChild("Select target") or (character and character:FindFirstChild("Select target")) then
		notify("Select target", "You already have the tool!")
		return
	end
	
	local tool = Instance.new("Tool")
	tool.Name = "Select target"
	tool.RequiresHandle = false
	
	tool.Activated:Connect(function()
		local mouse = LocalPlayer:GetMouse()
		local targetPart = mouse.Target
		if targetPart then
			local model = targetPart:FindFirstAncestorOfClass("Model")
			if model then
				local player = Players:GetPlayerFromCharacter(model)
				if player and player ~= LocalPlayer then
					TargetBox.Text = player.Name
					notify("Target Selected", "Target set to: " .. player.Name)
				end
			end
		end
	end)
	
	tool.Parent = backpack
	notify("Select target", "Tool added to your backpack!")
end)

