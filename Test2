function _G.Slam(targetInput, speaker)
	if not targetInput or targetInput == "" then return _G.Notify('Player Required', 'No target provided for Slam!') end

	_G.ResolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		_G.StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			local slamRunning = true
			local connection
			local angleAccumulator = 0

			connection = RunService.Heartbeat:Connect(function(dt)
				if not slamRunning or not character.Parent or not TRoot.Parent then
					if connection then connection:Disconnect() end
					return
				end

				pcall(function()
					angleAccumulator = angleAccumulator + (_G.SlamSpinSpeed * dt)
					Root.CFrame = TRoot.CFrame * CFrame.new(0, 0, -1) * CFrame.Angles(math.rad(angleAccumulator), 0, 0)
					
					if _G.SlamVelocity > 0 then
						local pushDir = (TRoot.Position - Root.Position)
						if pushDir.Magnitude > 0.1 then
							pushDir = pushDir.Unit
						else
							pushDir = Vector3.new(0, -1, 0)
						end
						Root.AssemblyLinearVelocity = (pushDir * _G.SlamVelocity) + Vector3.new(0, -15, 0)
						Root.RotVelocity = Vector3.new(_G.SlamSpinSpeed, 0, 0)
					else
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end

					if sethiddenproperty then
						sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
						sethiddenproperty(Root, "PhysicsRepRootRef", InstanceHandle.new(TRoot))
					end
				end)
			end)

			_G.CurrentWeld = {
				Destroy = function()
					slamRunning = false
					if connection then connection:Disconnect() end
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = _G.OriginalFPDH
				end
			}

			_G.Notify("Slam", "Executing velocity-backed slam on " .. TPlayer.Name .. "!")

			local elapsed = 0
			local holdTime = _G.SlamInterval or 2
			while elapsed < holdTime do
				if not slamRunning then break end
				task.wait(0.05)
				elapsed = elapsed + 0.05
			end

			if slamRunning then
				if connection then connection:Disconnect() end

				Root.CFrame = initialCFrame
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				workspace.FallenPartsDestroyHeight = _G.OriginalFPDH
				_G.CurrentWeld = nil

				_G.Notify("Slam", "Slam completed successfully!")
			end
		end)
	end)
end
