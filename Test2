--// Safe Notification Function
local function notify(title, text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 3
		})
	end)
end

--// Animation Management Functions (Only for Soaring / Combo)
local function playSoaringAnimation(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			pcall(function()
				if SoaringAnimTrack then
					SoaringAnimTrack:Stop()
					SoaringAnimTrack:Destroy()
				end
				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://91821363359739"
				SoaringAnimTrack = animator:LoadAnimation(anim)
				SoaringAnimTrack.Priority = Enum.AnimationPriority.Action4
				SoaringAnimTrack:Play()
			end)
		end
	end
end

local function stopSoaringAnimation()
	if SoaringAnimTrack then
		pcall(function() SoaringAnimTrack:Stop(); SoaringAnimTrack:Destroy() end)
		SoaringAnimTrack = nil
	end
end

--// Advanced Target Resolver (Name, nearest, farthest, random)
local function resolveTarget(stringer, speaker, callback)
	stringer = stringer and string.match(stringer, "^%s*(.-)%s*$") or ""
	stringer = string.lower(stringer)

	local character = speaker.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if stringer == "nearest" and root then
		local nearestPlr, shortestDist = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= speaker and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					nearestPlr = p.Name
				end
			end
		end
		if nearestPlr then callback(nearestPlr) else notify("Target", "No nearest player found!") end
		return
	end

	if stringer == "farthest" and root then
		local farthestPlr, longestDist = nil, -1
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= speaker and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
				if dist > longestDist then
					longestDist = dist
					farthestPlr = p.Name
				end
			end
		end
		if farthestPlr then callback(farthestPlr) else notify("Target", "No farthest player found!") end
		return
	end

	if stringer == "random" then
		local validPlayers = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= speaker and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(validPlayers, p.Name)
			end
		end
		if #validPlayers > 0 then
			callback(validPlayers[math.random(1, #validPlayers)])
		else
			notify("Target", "No valid random players found!")
		end
		return
	end

	local found = {}
	if stringer == "all" then
		for _, p in ipairs(Players:GetPlayers()) do table.insert(found, p.Name) end
	elseif stringer == "others" then
		for _, p in ipairs(Players:GetPlayers()) do if p ~= speaker then table.insert(found, p.Name) end end
	elseif stringer == "me" then
		table.insert(found, speaker.Name)
	else
		for _, p in ipairs(Players:GetPlayers()) do
			if string.sub(string.lower(p.Name), 1, #stringer) == stringer or string.sub(string.lower(p.DisplayName), 1, #stringer) == stringer then
				table.insert(found, p.Name)
			end
		end
	end

	if #found > 0 then
		callback(found[1])
	else
		notify("Target", "Player not found!")
	end
end

--// Stop Everything, Release Player and Clear Connections
local function StopWeld()
	stopSoaringAnimation()

	if CurrentWeld then
		if type(CurrentWeld) == "table" and CurrentWeld.Destroy then
			CurrentWeld:Destroy()
		elseif typeof(CurrentWeld) == "Instance" then
			CurrentWeld:Destroy()
		end
		CurrentWeld = nil
	end

	workspace.FallenPartsDestroyHeight = OriginalFPDH
	notify("Welder", "Actions stopped and player released!")
end
--// PART 2: Main Functions (Soaring beast & Rocket with Velocity)

local function SoaringBeast(targetInput, speaker: Player)
	if not targetInput or targetInput == "" then return notify('Player Required', 'No target provided for Soaring beast!') end

	resolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			playSoaringAnimation(character)

			local directions = {
				CFrame.new(0, 5, 0),
				CFrame.new(0, -3, 0),
				CFrame.new(0, 0, -3),
				CFrame.new(0, 0, 3),
				CFrame.new(-3, 0, 0),
				CFrame.new(3, 0, 0)
			}

			local soaringRunning = true

			CurrentWeld = {
				Destroy = function()
					soaringRunning = false
					stopSoaringAnimation()
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = OriginalFPDH
				end
			}

			if SoaringSequences > 0 then
				notify("Soaring beast", "Attacking " .. TPlayer.Name .. " (" .. SoaringSequences .. " cycles)...")
				
				for cycle = 1, SoaringSequences do
					for _, offset in ipairs(directions) do
						if not soaringRunning or not character.Parent or not TRoot.Parent then break end
						local destCFrame = TRoot.CFrame * offset
						Root.CFrame = CFrame.lookAt(destCFrame.Position, TRoot.Position)
						task.wait(SoaringSpeed)
					end
					if not soaringRunning then break end
				end
			else
				notify("Soaring beast", "Sequence 0: Going straight to Void with " .. TPlayer.Name)
			end

			if soaringRunning and character.Parent and TRoot.Parent then
				notify("Soaring beast", "Executing Void Drop!")
				
				local voidConnection
				voidConnection = RunService.Heartbeat:Connect(function()
					if not character.Parent or not TRoot.Parent then return end
					Root.CFrame = TRoot.CFrame * CFrame.new(0, -2, 0)
					Root.AssemblyLinearVelocity = Vector3.new(0, -500, 0) + Vector3.new(math.random(-400, 400), math.random(-800, -300), math.random(-400, 400))
					Root.RotVelocity = Vector3.new(40000, 40000, 40000)
					
					if sethiddenproperty then
						pcall(function()
							sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
							sethiddenproperty(Root, "PhysicsRepRootRef", InstanceHandle.new(TRoot))
						end)
					end
				end)

				local oldDestroy = CurrentWeld.Destroy
				CurrentWeld.Destroy = function()
					if voidConnection then voidConnection:Disconnect() end
					oldDestroy()
				end

				local elapsed = 0
				while elapsed < VoidDropDelay do
					if not soaringRunning then break end
					task.wait(0.1)
					elapsed = elapsed + 0.1
				end

				if voidConnection then voidConnection:Disconnect() end
			end

			if soaringRunning then
				stopSoaringAnimation()
				Root.CFrame = initialCFrame
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				workspace.FallenPartsDestroyHeight = OriginalFPDH
				CurrentWeld = nil

				notify("Soaring beast", "Action completed successfully!")
			end
		end)
	end)
end

local function Rocket(targetInput, speaker: Player, customVelocity, customTime)
	if not targetInput or targetInput == "" then return notify('Player Required', 'No target provided for Rocket!') end

	resolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			local rocketRunning = true
			local connection
			connection = RunService.Heartbeat:Connect(function()
				if not rocketRunning or not character.Parent or not TRoot.Parent then
					if connection then connection:Disconnect() end
					return
				end
				Root.CFrame = TRoot.CFrame * CFrame.new(0, RocketBaseHeight, 0) * CFrame.Angles(math.rad(RocketAngle), 0, 0)
				
				-- Using controlled Velocity to launch upwards instead of random fling
				local velPower = customVelocity and customVelocity > 0 and customVelocity or 250
				Root.AssemblyLinearVelocity = Vector3.new(0, velPower, 0)
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				
				if sethiddenproperty then
					pcall(function()
						sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
						sethiddenproperty(Root, "PhysicsRepRootRef", InstanceHandle.new(TRoot))
					end)
				end
			end)

			local bv = Instance.new("BodyVelocity")
			bv.Velocity = Vector3.new(0, customVelocity and customVelocity > 0 and customVelocity or 250, 0)
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.P = 1250
			bv.Parent = Root

			CurrentWeld = {
				Destroy = function()
					rocketRunning = false
					if connection then connection:Disconnect() end
					if bv then bv:Destroy() end
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = OriginalFPDH
				end
			}

			notify("Rocket", "Launching " .. TPlayer.Name .. " with Velocity upwards!")

			local elapsed = 0
			local waitTime = customTime or 0.5
			while elapsed < waitTime do
				if not rocketRunning then break end
				task.wait(0.05)
				elapsed = elapsed + 0.05
			end

			if rocketRunning then
				if connection then connection:Disconnect() end
				if bv then bv:Destroy() end

				Root.CFrame = initialCFrame
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				workspace.FallenPartsDestroyHeight = OriginalFPDH
				CurrentWeld = nil

				notify("Rocket", "Returned to initial position.")
			end
		end)
	end)
end
