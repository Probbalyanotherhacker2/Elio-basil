--// Directional Slam Function (No spin, positions based on selected direction)
local function Slam(targetInput, speaker: Player)
	if not targetInput or targetInput == "" then return notify('Player Required', 'No target provided for Slam!') end

	resolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			local slamRunning = true
			local connection

			connection = RunService.Heartbeat:Connect(function(dt)
				if not slamRunning or not character.Parent or not TRoot.Parent then
					if connection then connection:Disconnect() end
					return
				end

				pcall(function()
					local dirSetting = string.lower(tostring(SlamDirection))
					local targetOffset = CFrame.new(0, 3, 0) -- default Down (above)
					local pushVelocity = Vector3.new(0, -SlamVelocity, 0)

					if dirSetting == "forward" then
						-- Position behind player, push forward (towards victim's look vector)
						targetOffset = CFrame.new(0, 0, 3) * CFrame.Angles(0, math.pi, 0)
						pushVelocity = TRoot.CFrame.LookVector * SlamVelocity
					elseif dirSetting == "backward" then
						-- Position in front of player, push backward
						targetOffset = CFrame.new(0, 0, -3)
						pushVelocity = -TRoot.CFrame.LookVector * SlamVelocity
					elseif dirSetting == "up" then
						-- Position below player, push up
						targetOffset = CFrame.new(0, -3, 0)
						pushVelocity = Vector3.new(0, SlamVelocity, 0)
					else -- "down" or default
						targetOffset = CFrame.new(0, 3, 0)
						pushVelocity = Vector3.new(0, -SlamVelocity, 0)
					end

					Root.CFrame = TRoot.CFrame * targetOffset
					Root.AssemblyLinearVelocity = pushVelocity
					Root.AssemblyAngularVelocity = Vector3.zero
					Root.RotVelocity = Vector3.zero

					if sethiddenproperty then
						sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
						sethiddenproperty(Root, "PhysicsRepRootRef", InstanceHandle.new(TRoot))
					end
				end)
			end)

			CurrentWeld = {
				Destroy = function()
					slamRunning = false
					if connection then connection:Disconnect() end
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = OriginalFPDH
				end
			}

			notify("Slam", "Executing directional slam (" .. SlamDirection .. ") on " .. TPlayer.Name .. "!")

			local elapsed = 0
			local holdTime = SlamInterval or 2
			while elapsed < holdTime do
				if not slamRunning then break end
				task.wait(0.05)
				elapsed = elapsed + 0.05
			end

			if slamRunning then
				if connection then connection:Disconnect() end

				Root.CFrame = initialCFrame
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				workspace.FallenPartsDestroyHeight = OriginalFPDH
				CurrentWeld = nil

