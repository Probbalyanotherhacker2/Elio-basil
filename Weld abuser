local function Slam(targetInput, speaker: Player, customVelocity)
	if not targetInput or targetInput == "" then return notify('Player Required', 'No target provided for Slam!') end

	resolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			local slamRunning = true
			local connection

			connection = RunService.Heartbeat:Connect(function(dt)
				if not slamRunning or not character.Parent or not TRoot.Parent then
					if connection then connection:Disconnect() end
					return
				end

				pcall(function()
					local velPower = (customVelocity and customVelocity ~= 0) and customVelocity or 200
					local pushDir = Vector3.new(0, -1, 0)

					if SelectedSlamTarget then
						local victimPos = TRoot.Position
						local vec = SelectedSlamTarget - victimPos
						if vec.Magnitude > 0.1 then
							pushDir = vec.Unit
							local backPos = victimPos - (pushDir * SlamOffsetDistance)
							Root.CFrame = CFrame.lookAt(backPos, victimPos)
						else
							Root.CFrame = TRoot.CFrame * CFrame.new(0, SlamOffsetDistance, 0)
						end
					else
						Root.CFrame = TRoot.CFrame * CFrame.new(0, SlamOffsetDistance, 0)
					end

					Root.AssemblyLinearVelocity = pushDir * velPower
					Root.AssemblyAngularVelocity = Vector3.zero
					Root.RotVelocity = Vector3.zero

					if sethiddenproperty then
						sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
					end
				end)
			end)

			CurrentWeld = {
				Destroy = function()
					slamRunning = false
					if connection then connection:Disconnect() end
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = OriginalFPDH
				end
			}

			notify("Slam", "Executing directional slam on " .. TPlayer.Name .. "!")

			local elapsed = 0
			local holdTime = SlamInterval or 0.2
			while elapsed < holdTime do
				if not slamRunning then break end
				task.wait(0.05)
				elapsed = elapsed + 0.05
			end

			if slamRunning then
				if connection then connection:Disconnect() end

				Root.CFrame = initialCFrame
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
				workspace.FallenPartsDestroyHeight = OriginalFPDH
				CurrentWeld = nil

				notify("Slam", "Slam completed successfully!")
			end
		end)
	end)
end

--// Magic Carpet Function
local function MagicCarpet(targetInput, speaker: Player, customVelocity)
	if not targetInput or targetInput == "" then return notify('Player Required', 'No target provided for Magic carpet!') end

	resolveTarget(targetInput, speaker, function(v)
		local TPlayer = Players:FindFirstChild(v)
		if not TPlayer or not TPlayer.Character or TPlayer == speaker then return end

		StopWeld()

		local TCharacter = TPlayer.Character
		local TRoot = TCharacter:WaitForChild("HumanoidRootPart", 2) or TCharacter:FindFirstChild("Torso") or TCharacter:FindFirstChild("UpperTorso")
		if not TRoot then return end

		local character = speaker.Character
		if not character then return end
		local Root = character:WaitForChild("HumanoidRootPart", 2)
		if not Root then return end

		MagicCarpetRunning = true
		if MagicCarpetGui then MagicCarpetGui.Visible = true end

		task.spawn(function()
			local initialCFrame = Root.CFrame
			workspace.FallenPartsDestroyHeight = 0/0

			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			local camera = workspace.CurrentCamera
			local connection
			connection = RunService.Heartbeat:Connect(function()
				if not MagicCarpetRunning or not character.Parent or not TRoot.Parent then
					if connection then connection:Disconnect() end
					return
				end

				pcall(function()
					-- Compartilha o ângulo do Rocket nas configurações e aplica o offset dinâmico
					local targetCFrame = TRoot.CFrame * CFrame.new(0, -MagicCarpetOffset, 0) * CFrame.Angles(math.rad(RocketAngle), 0, 0)
					Root.CFrame = targetCFrame

					local velPower = (customVelocity and customVelocity ~= 0) and customVelocity or 200

					local camCF = camera.CFrame
					local lookVec = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
					local rightVec = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

					local moveVel = Vector3.zero
					if MagicCarpetMoveDir.Magnitude > 0 then
						local moveDirW = (lookVec * MagicCarpetMoveDir.Z) + (rightVec * MagicCarpetMoveDir.X)
						moveVel = moveDirW * velPower
					end

					Root.AssemblyLinearVelocity = moveVel
					Root.AssemblyAngularVelocity = Vector3.zero
					Root.RotVelocity = Vector3.zero

					if sethiddenproperty then
						sethiddenproperty(Root, "PhysicsRepRootPart", TRoot)
					end
				end)
			end)

			CurrentWeld = {
				Destroy = function()
					MagicCarpetRunning = false
					MagicCarpetMoveDir = Vector3.zero
					if MagicCarpetGui then MagicCarpetGui.Visible = false end
					if connection then connection:Disconnect() end
					if Root then
						Root.CFrame = initialCFrame
						Root.AssemblyLinearVelocity = Vector3.zero
						Root.AssemblyAngularVelocity = Vector3.zero
						Root.RotVelocity = Vector3.zero
					end
					workspace.FallenPartsDestroyHeight = OriginalFPDH
				end
			}

			notify("Magic Carpet", "Riding with " .. TPlayer.Name .. "!")
		end)
	end)
end
